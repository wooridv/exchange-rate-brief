# 로컬 실행용 환경변수 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# (.env 는 .gitignore 로 커밋되지 않습니다. 실제 값은 GitHub Secrets 에 등록)

# 잔디 Incoming Webhook URL (발송 시 필수) — 절대 저장소/사이트에 커밋하지 말 것
JANDI_WEBHOOK_URL=

# 대시보드 공개 URL (옵션, 잔디 메시지의 상세 링크로 사용)
# 예: https://내계정.github.io/exchange-brief/
REPORT_BASE_URL=

# 차트/신호에 쓸 일별 히스토리 일수 (옵션, 기본 60)
HISTORY_DAYS=60
